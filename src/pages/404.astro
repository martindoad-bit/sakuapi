---
import Layout from '../layouts/Layout.astro';
---

<Layout title="页面不存在 · Sakuapi">
  <div class="max-w-xl mx-auto px-6 py-24 text-center">
    <div class="text-6xl mb-6">🔍</div>
    <h1 class="text-2xl font-bold mb-3">这个页面暂时打不开</h1>
    <p class="text-neutral-600 mb-2">如果是<strong>刚保存的新文章</strong>，站点正在自动构建，约 1-2 分钟后生效。</p>
    <p class="text-neutral-500 text-sm mb-8" id="retry-hint">30 秒后自动重试一次…</p>
    <div class="flex items-center justify-center gap-3">
      <button id="retry-btn" class="px-5 py-2.5 bg-orange-600 hover:bg-orange-700 text-white rounded-md font-medium transition">现在重试</button>
      <a href="/" class="px-5 py-2.5 border border-neutral-300 hover:border-orange-400 text-neutral-700 rounded-md font-medium transition">回首页</a>
    </div>
  </div>

  <script is:inline>
    document.getElementById('retry-btn').addEventListener('click', () => window.location.reload());
    // 自动重试一次（应对「新文章还在构建」的窗口期）
    if (!sessionStorage.getItem('sakuapi-404-retried-' + location.pathname)) {
      setTimeout(() => {
        sessionStorage.setItem('sakuapi-404-retried-' + location.pathname, '1');
        window.location.reload();
      }, 30000);
    } else {
      document.getElementById('retry-hint').textContent = '已重试过一次。如果一直打不开，这篇文章可能已被删除或改名。';
    }
  </script>
</Layout>
